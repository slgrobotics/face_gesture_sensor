<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>face_gesture_sensor</name>
  <version>0.1.0</version>
  <description>Face and Gesture detection node</description>
  <!-- based on https://github.com/DFRobot/DFRobot_GestureFaceDetection/tree/master/python/raspberrypi  -->
  <maintainer email="slg@quakemap.com">Sergei Grichine</maintainer>
  <!-- preserving original DFRobot license -->
  <license>MIT</license>

  <depend>rclpy</depend>
  <build_depend>python3-setuptools</build_depend>
  
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>alsa-utils</exec_depend>
  <exec_depend>flite</exec_depend>
  <exec_depend>python3-smbus2</exec_depend>

  <buildtool_depend>ament_python</buildtool_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
